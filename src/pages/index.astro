---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Products from "../components/Products.astro";
import About from "../components/About.astro";
import Map from "../components/Map.astro";
---

<Layout
  title="Pani Construcciones | Casas en Steel Framing e Isopanel"
  description="¡Líder en la construcción de casas modernas, eficientes y de alta calidad! Descubre nuestra variedad de proyectos en Steel Framing e Isopanel."
>
  <!-- Hero anula el pt del main para ocupar el viewport completo desde el header -->
  <div class="-mt-[4.5rem] lg:-mt-[5.5rem]">
    <Hero />
  </div>

  <section class="py-2">
    <Products />
  </section>

  <section>
    <About />
  </section>

  <section>
    <Map />
  </section>
</Layout>
