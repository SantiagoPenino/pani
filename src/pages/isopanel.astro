---
import Layout from "../layouts/Layout.astro";
import ProjectLines from "../components/ProjectLines.astro";
import LineComparator from "../components/LineComparator.astro";
import About from "../components/About.astro";
---

<Layout
  title="Proyectos en Isopanel | Pani Construcciones"
  description="Descubrí nuestros proyectos en Isopanel y encontrá la solución perfecta para tu nuevo hogar. Construcciones modernas, eficientes y de alta calidad."
>
  <!-- Encabezado de página -->
  <div class="flex items-center justify-center bg-gradient-to-br from-custom-gray via-custom-blue-dark to-custom-blue px-5 py-8 text-center text-white -mt-[4.5rem] pt-24 lg:-mt-[5.5rem] lg:px-10 lg:py-10 lg:pt-28">
    <h1 class="inline-flex items-center justify-center gap-2.5 font-archivo text-2xl font-extrabold leading-tight sm:text-3xl lg:text-4xl">
      <svg class="h-7 w-7 shrink-0 text-white sm:h-8 sm:w-8" fill="currentColor" viewBox="0 0 20 20">
        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
      </svg>
      <span>Construcciones <span class="text-custom-original">en Isopanel</span></span>
    </h1>
  </div>

  <!-- Tarjeta de Isopanel con acceso a cada línea -->
  <ProjectLines systems={["isopanel"]} />

  <!-- Comparador de líneas -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <LineComparator system="Isopanel" />
  </section>

  <section>
    <About />
  </section>
</Layout>
