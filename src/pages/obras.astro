---
import Layout from "../layouts/Layout.astro";
import About from "../components/About.astro";
import Gallery from "../components/Gallery.astro";
---

<Layout
  title="Galería de obras realizadas en Steel Framing e Isopanel | Pani Construcciones"
  description="Explorá nuestra galería de obras realizadas en Steel Framing e Isopanel. Descubrí la calidad e innovación en cada proyecto. ¡Inspirate para tu próxima construcción!"
>
  <!-- Hero de página (solo desktop) -->
  <div class="hidden lg:flex bg-gradient-to-br from-custom-gray via-custom-blue-dark to-custom-blue text-white px-5 lg:px-10 py-8 lg:py-10 text-center -mt-[4.5rem] lg:-mt-[5.5rem] pt-24 lg:pt-28 justify-center items-center">
    <h1 class="inline-flex items-center justify-center gap-2.5 font-archivo font-extrabold text-2xl sm:text-3xl lg:text-4xl leading-tight">
      <svg class="w-7 h-7 sm:w-8 sm:h-8 text-white shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
      </svg>
      <span>Obras <span class="text-custom-original">realizadas</span></span>
    </h1>
  </div>

  <!-- Galería -->
  <section class="py-8 lg:py-12 px-4">
    <Gallery />
  </section>

  <!-- About -->
  <section>
    <About />
  </section>
</Layout>
