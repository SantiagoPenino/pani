---
import Layout from "../layouts/Layout.astro";
import Modal from "../components/Modal.astro";
import { allProducts } from "../utils/projects.js";
import CallToAction from "../components/CallToAction.astro";

export function getStaticPaths() {
  const paths = allProducts.map((product) => ({
    params: { code: product.code },
  }));
  return paths;
}

const { code } = Astro.params;
const productData = allProducts.find((product) => product.code === code);

if (!productData) {
  // Inalcanzable con getStaticPaths; queda como guarda para el tipado
  throw new Error(`Proyecto no encontrado: ${code}`);
}

const {
  category,
  imgAlt,
  price,
  size,
  line,
  system,
  roof,
  description,
  cover,
  estimated,
  images,
  front,
  extras,
  features,
} = productData;

const isPremium = line === "Premium";
// Volver a la sección de la línea correspondiente (Steel Framing en "/", Isopanel en "/isopanel")
const backHref = category.startsWith("iso-") ? `/isopanel#${category}` : `/#${category}`;
const proyectUrl = `https://paniconstrucciones.com/${code}`;
const imageUrl = `https://paniconstrucciones.com/assets/images/proyectos/${category}/${code}.webp`;

// Características: usar features del resolver directamente
const caracteristicas = features;
---

<Layout
  title={`Proyecto ${code} | Pani Construcciones`}
  description={`Conocé el proyecto ${code}, una residencia moderna en ${system}. Descubrí sus características. ¡Construí tu casa con nosotros!`}
  imageUrl={imageUrl}
>
  <article class="w-full">

    <!-- ── Hero con imagen full width ── -->
    <div class="relative w-full overflow-hidden" style="aspect-ratio: 16/6; min-height: 240px;">
      <!-- Botón Volver -->
      <a
        href={backHref}
        class="absolute top-4 left-4 z-20 inline-flex items-center gap-1.5 text-white/90 hover:text-white text-sm font-semibold bg-black/30 backdrop-blur-sm px-3.5 py-2 rounded-full border border-white/20 transition-all hover:bg-black/50"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Volver
      </a>
      <img
        width="1360"
        height="510"
        class="w-full h-full object-cover"
        src={`/assets/images/proyectos/${category}/${code}.webp`}
        alt={imgAlt}
        loading="eager"
      />
      <!-- Overlay degradado -->
      <div class="absolute inset-0 bg-gradient-to-r from-custom-black/80 via-custom-black/30 to-transparent"></div>

      <!-- Info flotante sobre imagen -->
      <div class="absolute inset-0 flex flex-col justify-end p-5 lg:p-10">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class={`line-badge text-xs ${isPremium ? "gold" : ""}`}>
            {line}
          </span>
          <span class="text-white/60 text-xs">Código: {code}</span>
        </div>
        <h1 class="font-archivo font-extrabold text-white text-2xl sm:text-3xl lg:text-5xl leading-tight">
          {size}m² · Techo {roof}
        </h1>
      </div>

      <!-- Botón favorito -->
      <button class="fav-btn absolute top-4 right-16 w-10 h-10 rounded-full bg-white/15 backdrop-blur-sm border border-white/25 text-white flex items-center justify-center hover:bg-white/25 transition-colors z-20" data-code={code} aria-label="Guardar favorito" onclick="event.preventDefault();event.stopPropagation();window.toggleFav(this)">
        <svg class="fav-icon-empty w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
        <svg class="fav-icon-full w-4 h-4 hidden" fill="#ef4444" stroke="#ef4444" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
      </button>

      <!-- Botón compartir -->
      <a
        href={`https://wa.me/?text=${encodeURIComponent(proyectUrl)}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Compartir proyecto por WhatsApp"
        class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/15 backdrop-blur-sm border border-white/25 text-white flex items-center justify-center hover:bg-white/25 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185z"/></svg>
      </a>
    </div>

    <!-- ── Contenido principal ── -->
    <div class="max-w-6xl mx-auto px-5 lg:px-10 py-10 lg:py-14">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">

        <!-- Columna izquierda — descripción + características -->
        <div class="reveal">
          <p class="text-custom-gray/70 text-sm sm:text-base leading-relaxed mb-6">{description}</p>
          {extras && (
            <p class="text-custom-gray/60 text-sm italic mb-6 pl-3 border-l-2 border-custom-original">{extras}</p>
          )}

          <h2 class="font-archivo font-bold text-xl text-custom-black mb-5 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-gradient-to-b from-custom-blue to-custom-original rounded-full inline-block shrink-0"></span>
            Características incluidas
          </h2>

          <ul class="space-y-2.5">
            {caracteristicas.map((item) => (
              <li class="flex items-start gap-3 text-sm text-custom-gray/80">
                <svg class="w-4 h-4 text-custom-original mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <!-- Nota de opcionales -->
          <p class="mt-5 text-xs text-custom-gray/50 italic">
            (*) Consultar por opcionales: parrillero, pérgola, deck, piscina, vereda perimetral, etc.
          </p>
        </div>

        <!-- Columna derecha — precio + plano + CTAs -->
        <div class="reveal reveal-delay-2">

          <!-- Card de precio -->
          <div class="bg-gradient-to-br from-custom-gray to-custom-blue-dark text-white rounded-2xl p-6 lg:p-8 mb-6 relative overflow-hidden">
            <div class="absolute inset-0 opacity-5" aria-hidden="true"
              style="background-image: radial-gradient(circle at 80% 20%, white 1px, transparent 1px); background-size: 20px 20px;">
            </div>
            <p class="text-white/60 text-xs uppercase tracking-widest mb-1">Precio final llave en mano</p>
            <p class="font-archivo font-extrabold text-4xl lg:text-5xl text-white mb-1">U$S {price}</p>
            <p class="text-white/55 text-xs italic mb-5">con terminación de techo {roof}</p>

            <div class="space-y-2 text-xs text-white/70 border-t border-white/15 pt-4">
              <p class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-custom-original shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                Incluye mano de obra y materiales
              </p>
              <p class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-custom-original shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                Anteproyecto y proyecto ejecutivo
              </p>
              <p class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-custom-original shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                Trámites ante BPS, DGI, MTSS, FOCER e Intendencia
              </p>
            </div>

            <div class="mt-4 flex items-center gap-2 text-white/60 text-xs">
              <svg class="w-4 h-4 text-custom-original" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Tiempo de obra: <strong class="text-white">{estimated} días hábiles</strong>
            </div>
          </div>

          <!-- Plano -->
          <div class="mb-6">
            <p class="text-xs font-bold uppercase tracking-widest text-custom-gray/50 mb-2">Plano del proyecto</p>
            <Modal
              src={`/assets/images/proyectos/${category}/${code}/plano.webp`}
              alt={`Plano de obra del proyecto ${code}`}
              noOverlay={true}
            />
          </div>

        </div>
      </div>

      <!-- ── CTAs centrados en todo el viewport ── -->
      <div class="flex flex-col sm:flex-row justify-center items-center gap-6 mt-12 w-full reveal">
        <a
          class="w-full sm:w-auto min-w-[200px] inline-flex items-center justify-center gap-2 bg-gradient-to-r from-custom-blue to-custom-original hover:brightness-110 text-white font-archivo font-bold text-sm uppercase px-8 py-4 rounded-full transition-all duration-200 shadow-lg hover:scale-105"
          href="/contacto"
        >
          Contacto
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          class="w-full sm:w-auto min-w-[200px] inline-flex items-center justify-center gap-2 bg-custom-green hover:bg-custom-whatsapp text-white font-archivo font-bold text-sm uppercase px-8 py-4 rounded-full transition-all duration-200 shadow-lg hover:scale-105"
          href={`https://wa.me/598099491227?text=Hola%2C%20me%20gustar%C3%ADa%20solicitar%20m%C3%A1s%20informaci%C3%B3n%20sobre%20el%20proyecto%20${code}%20de%20la%20l%C3%ADnea%20${line}.`}
          target="_blank"
          rel="noopener noreferrer"
          id={`whatsapp-project-${code}`}
        >
          <svg class="w-4 h-4" viewBox="0 0 448 512">
            <path fill="currentColor" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
          </svg>
          WhatsApp
        </a>
      </div>
    </div>

    <!-- ── Galería de imágenes del proyecto ── -->
    {images && images.length > 0 && (
      <div class="bg-custom-surface py-10 lg:py-14">
        <div class="max-w-6xl mx-auto px-5 lg:px-10">
          <h2 class="font-archivo font-bold text-xl lg:text-2xl text-custom-black mb-6 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-gradient-to-b from-custom-blue to-custom-original rounded-full inline-block shrink-0"></span>
            Más imágenes del proyecto
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {images.map((image) => (
              <Modal
                src={`/assets/images/proyectos/${category}/${code}/${image}.webp`}
                alt={`Imagen del proyecto ${code}`}
              />
            ))}
          </div>
        </div>
      </div>
    )}

  </article>
</Layout>

