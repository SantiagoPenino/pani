---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contacto | Pani Construcciones"
  description="¿Listo para construir tu hogar ideal en Steel Framing e Isopanel? ¡Contáctanos hoy para comenzar tu proyecto de construcción con Pani Construcciones!"
>
  <section class="min-h-[80vh] flex flex-col lg:flex-row">

    <!-- Panel izquierdo — info -->
    <div class="lg:w-2/5 bg-gradient-to-br from-custom-gray via-custom-blue-dark to-custom-blue text-white flex flex-col justify-center px-8 py-14 lg:py-20 lg:px-12">
      <span class="section-badge bg-white/15 border border-white/20 inline-flex mb-5 self-start">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
        </svg>
        Contacto
      </span>

      <h1 class="font-archivo font-extrabold text-3xl lg:text-4xl leading-tight mb-4">
        Contáctate<br/>con nosotros
      </h1>
      <p class="text-white/65 text-sm lg:text-base leading-relaxed mb-10">
        Completá el formulario y te respondemos a la brevedad. También podés contactarnos directamente por teléfono o WhatsApp.
      </p>

      <!-- Info de contacto -->
      <ul class="space-y-5">
        <li class="flex items-center gap-4">
          <span class="footer-social-icon shrink-0 bg-white/10">
            <svg class="w-5 h-5 text-custom-original" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
            </svg>
          </span>
          <div>
            <p class="text-white/40 text-xs uppercase tracking-widest">Email</p>
            <a href="mailto:contacto@paniconstrucciones.com" class="text-white text-sm font-medium hover:text-custom-original transition-colors">
              contacto@paniconstrucciones.com
            </a>
          </div>
        </li>
        <li class="flex items-center gap-4">
          <span class="footer-social-icon shrink-0 bg-white/10">
            <svg class="w-5 h-5 text-custom-original" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
            </svg>
          </span>
          <div>
            <p class="text-white/40 text-xs uppercase tracking-widest">Teléfono</p>
            <a href="tel:099491227" class="text-white text-sm font-medium hover:text-custom-original transition-colors">
              099 491 227 · 2682 0961
            </a>
          </div>
        </li>
        <li class="flex items-center gap-4">
          <span class="footer-social-icon shrink-0 bg-white/10">
            <svg class="w-5 h-5 text-custom-original" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </span>
          <div>
            <p class="text-white/40 text-xs uppercase tracking-widest">Horario</p>
            <p class="text-white text-sm font-medium">Lun a Vie · 9:00 — 17:00</p>
          </div>
        </li>
      </ul>
    </div>

    <!-- Panel derecho — formulario -->
    <div class="lg:w-3/5 bg-white flex items-center justify-center px-6 py-12 lg:px-16 lg:py-20">
      <div class="w-full max-w-lg">
        <h2 class="font-archivo font-bold text-xl lg:text-2xl text-custom-black mb-1">Envianos un mensaje</h2>
        <p class="text-custom-gray/50 text-sm mb-8">Respondemos dentro de las 24 horas hábiles.</p>

        <!-- Formulario -->
        <form id="contact-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="flex flex-col gap-1.5">
              <label for="name" class="text-xs font-bold uppercase tracking-widest text-custom-gray/60">Nombre *</label>
              <input
                class="form-input"
                placeholder="Tu nombre completo"
                type="text"
                id="name"
                name="name"
                required
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="phone" class="text-xs font-bold uppercase tracking-widest text-custom-gray/60">Teléfono *</label>
              <input
                type="number"
                id="phone"
                name="phone"
                placeholder="Ej: 099 123 456"
                class="form-input no-spinner"
                required
              />
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-xs font-bold uppercase tracking-widest text-custom-gray/60">Correo electrónico *</label>
            <input
              class="form-input"
              placeholder="tu@email.com"
              type="email"
              id="email"
              name="email"
              required
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="message" class="text-xs font-bold uppercase tracking-widest text-custom-gray/60">Mensaje *</label>
            <textarea
              class="form-textarea"
              placeholder="Contanos sobre tu proyecto..."
              id="message"
              name="message"
              required
            ></textarea>
          </div>

          <button
            class="btn-primary w-full justify-center text-sm py-3.5"
            type="submit"
            id="submit-contact-btn"
          >
            Enviar mensaje
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>

  <script src="../../src/scripts/emailjs.js"></script>
</Layout>
