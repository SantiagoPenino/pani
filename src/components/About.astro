        </div>
      </div>

      <!-- Columna derecha — stats -->
      <div class="reveal reveal-delay-2">
        <div class="grid grid-cols-2 gap-4">

          <!-- Stat 1 -->
          <div class="bg-white rounded-2xl p-6 shadow-card-base border border-custom-white/60 text-center">
