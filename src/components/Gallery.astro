---

<div class="relative w-full lg:w-[85%] mx-auto py-4 lg:py-8" id="gallery-root">

  <!-- Contador de imagen -->
  <div class="flex items-center justify-between px-2 mb-3">
    <p class="text-xs text-custom-gray/50 font-semibold uppercase tracking-widest">Obras realizadas</p>
    <p class="text-xs font-bold text-custom-blue" id="gallery-counter">1 / {total}</p>
  </div>

  <!-- Contenedor de imágenes -->
  <div class="relative overflow-hidden rounded-xl shadow-card-hover" style="aspect-ratio: 16/9;">
    <div
      class="flex w-full h-full transition-transform duration-500 ease-in-out"
      id="carousel-items"
    >
      {
        finished.map(({ id, details, city }) => (
          <div class="w-full h-full flex-shrink-0 relative">
            <img
              width="1360"
              height="765"
              src={`/assets/images/obras/${id}.webp`}
              class="w-full h-full object-cover"
              alt={`Obra en ${details} — ${city}`}
              loading="lazy"
            />
            <!-- Caption overlay -->
            <div class="gallery-caption">
              <div class="flex items-end justify-between gap-2">
                <div>
                  <p class="text-white font-bold text-sm sm:text-base lg:text-lg leading-tight">{details}</p>
                  <p class="text-white/70 text-xs sm:text-sm flex items-center gap-1 mt-0.5">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                    </svg>
                    {city}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Barra de progreso -->
    <div class="gallery-progress" id="gallery-progress" style="width: calc(100% / 43)"></div>

    <!-- Botón anterior -->
    <button
      type="button"
      class="gallery-btn left-3"
      id="gallery-prev"
      aria-label="Imagen anterior"
      disabled
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>

    <!-- Botón siguiente -->
    <button
      type="button"
      class="gallery-btn right-3"
      id="gallery-next"
      aria-label="Imagen siguiente"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </button>
  </div>

  <!-- Puntos de navegación (solo móvil — máx 10 puntos visibles) -->
  <div class="flex justify-center gap-1.5 mt-4 lg:hidden" id="gallery-dots" aria-hidden="true">
    {finished.slice(0, 10).map((_, i) => (
      <button
        data-dot={i}
        class={`w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? "bg-custom-blue w-5" : "bg-custom-white"}`}
        aria-label={`Ir a imagen ${i + 1}`}
      ></button>
    ))}
    <span class="text-xs text-custom-gray/40 self-center ml-1">+{total - 10}</span>
  </div>
</div>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const prevBtn = document.getElementById("gallery-prev");
    const nextBtn = document.getElementById("gallery-next");
    const container = document.getElementById("carousel-items");
    const progressBar = document.getElementById("gallery-progress");
    const counterEl = document.getElementById("gallery-counter");
    const dots = document.querySelectorAll("[data-dot]");

    if (!prevBtn || !nextBtn || !container) return;

    const items = container.querySelectorAll(":scope > div");
    const total = items.length;
    let idx = 0;

    function goTo(newIdx) {
      idx = Math.max(0, Math.min(newIdx, total - 1));
      container.style.transform = `translateX(-${idx * 100}%)`;

      // Progreso
      if (progressBar) {
        progressBar.style.width = `${((idx + 1) / total) * 100}%`;
      }

      // Contador
      if (counterEl) counterEl.textContent = `${idx + 1} / ${total}`;

      // Botones
      prevBtn.disabled = idx === 0;
      nextBtn.disabled = idx === total - 1;

      // Dots (solo los 10 primeros)
      dots.forEach((dot) => {
        const dotIdx = parseInt(dot.dataset.dot, 10);
        dot.classList.toggle("bg-custom-blue", dotIdx === idx);
        dot.classList.toggle("w-5", dotIdx === idx);
        dot.classList.toggle("bg-custom-white", dotIdx !== idx);
        dot.classList.toggle("w-2", dotIdx !== idx);
      });
    }

    prevBtn.addEventListener("click", () => goTo(idx - 1));
    nextBtn.addEventListener("click", () => goTo(idx + 1));

    // Touch swipe
    let touchStartX = 0;
    container.addEventListener("touchstart", (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    container.addEventListener("touchend", (e) => {
      const delta = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(delta) > 40) goTo(delta > 0 ? idx + 1 : idx - 1);
    }, { passive: true });

    // Dots
    dots.forEach((dot) => {
      dot.addEventListener("click", () => goTo(parseInt(dot.dataset.dot, 10)));
    });

    goTo(0);
  });
</script>
