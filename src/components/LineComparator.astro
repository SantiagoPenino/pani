---
/**
 * Comparador visual de líneas (Premium vs Ejecutiva Plus vs Básica).
 * Props:
 *  - system: "Steel Framing" | "Isopanel"
 */
const { system = "Steel Framing" } = Astro.props;

const isSF = system === "Steel Framing";

// Datos comparativos basados en las features reales del JSON
const rows = isSF ? [
  { feature: "Cubierta Isopanel",       premium: "15 cm",                    exeplus: "15 cm",                    basica: "10 cm" },
  { feature: "Aislación exterior",      premium: "EIFS (escudo térmico)",    exeplus: "EIFS (escudo térmico)",    basica: "Placa cementicia" },
  { feature: "Aberturas aluminio",      premium: "Serie Gala · DVH",        exeplus: "Serie Probba · DVH",       basica: "Serie 25 · Vidrio simple" },
  { feature: "Mosquiteros",             premium: "✓ Incluidos",              exeplus: "—",                        basica: "—" },
  { feature: "Puerta exterior",         premium: "Madera maciza",            exeplus: "Madera maciza",            basica: "Semiblindada" },
  { feature: "Puertas interiores",      premium: "Importadas a elección",    exeplus: "Importadas a elección",    basica: "MDF con PVC" },
  { feature: "Pisos y revestimientos",  premium: "Porcelanato",              exeplus: "Porcelanato",              basica: "Cerámica" },
  { feature: "Pintura interior",        premium: "Lavable · Color a elección", exeplus: "Color a elección",       basica: "Color blanco" },
  { feature: "Isla de cocina",          premium: "✓ Incluida",               exeplus: "—",                        basica: "—" },
  { feature: "Mesada granito",          premium: "Isla + bajo mesada",       exeplus: "Bajo mesada",              basica: "Bajo mesada" },
  { feature: "Mueble cocina",           premium: "Aéreo + bajo mesada",      exeplus: "Aéreo + bajo mesada",      basica: "Bajo mesada" },
  { feature: "Placares / Vestidor",     premium: "✓ Incluidos",              exeplus: "—",                        basica: "—" },
  { feature: "Baño",                    premium: "Inodoro + bidet + mueble", exeplus: "Inodoro + bidet + mueble", basica: "Inodoro + mueble" },
  { feature: "Precio desde (m²)",       premium: "U$S 1.775",               exeplus: "U$S 1.630",                basica: "U$S 1.490" },
] : [
  { feature: "Muros Isopanel",          premium: "15 cm",                    exeplus: "10 cm",                    basica: "10 cm" },
  { feature: "Cubierta Isopanel",       premium: "15 cm",                    exeplus: "10 cm",                    basica: "10 cm" },
  { feature: "Cielorraso",              premium: "Yeso + lana de vidrio",    exeplus: "—",                        basica: "—" },
  { feature: "Exterior",                premium: "EIFS 3 manos + revoque",   exeplus: "Pintura texturada",        basica: "Isopanel blanco" },
  { feature: "Interior",                premium: "Yeso + masillado",         exeplus: "Yeso",                     basica: "Isopanel blanco" },
  { feature: "Aberturas aluminio",      premium: "Probba · DVH + mosquiteros", exeplus: "Probba · Vidrio simple", basica: "Serie 25 · Vidrio simple" },
  { feature: "Puerta exterior",         premium: "Madera maciza",            exeplus: "Madera maciza",            basica: "Semiblindada" },
  { feature: "Puertas interiores",      premium: "Importadas",               exeplus: "MDF con PVC",              basica: "MDF con PVC" },
  { feature: "Pisos y revestimientos",  premium: "Porcelanato",              exeplus: "Cerámica",                 basica: "Cerámica" },
  { feature: "Pintura",                 premium: "Interior + exterior a elección", exeplus: "Interior a elección", basica: "—" },
  { feature: "Mueble cocina",           premium: "Aéreo + bajo mesada",      exeplus: "Bajo mesada",              basica: "Bajo mesada" },
  { feature: "Baño",                    premium: "Inodoro + bidet + mueble", exeplus: "Inodoro + mueble",         basica: "Inodoro + mueble" },
  { feature: "Precio desde (m²)",       premium: "U$S 1.500",               exeplus: "U$S 1.200",                basica: "U$S 1.000" },
];
---

<section class="mt-16 mb-8 reveal">
  <!-- Título -->
  <div class="text-center mb-8">
    <h2 class="font-archivo font-extrabold text-xl sm:text-2xl lg:text-3xl text-custom-black">
      Comparar líneas de <span class="text-custom-blue">{system}</span>
    </h2>
    <p class="text-sm text-custom-gray mt-2 max-w-lg mx-auto">
      Descubrí las diferencias entre nuestras líneas y elegí la que mejor se adapte a tu proyecto.
    </p>
  </div>

  <!-- Tabla Desktop -->
  <div class="hidden md:block overflow-x-auto rounded-2xl border border-custom-white/80 shadow-card-base">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="bg-gradient-to-r from-custom-gray via-custom-blue-dark to-custom-blue text-white">
          <th class="py-4 px-5 font-archivo font-bold text-xs uppercase tracking-wider w-[28%]">Característica</th>
          <th class="py-4 px-5 font-archivo font-bold text-xs uppercase tracking-wider text-center">
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-custom-gold shadow-[0_0_6px_rgba(234,179,8,0.6)]"></span>
              ★ Premium
            </span>
          </th>
          <th class="py-4 px-5 font-archivo font-bold text-xs uppercase tracking-wider text-center">
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-custom-original shadow-[0_0_6px_rgba(0,166,251,0.6)]"></span>
              Ejecutiva Plus
            </span>
          </th>
          <th class="py-4 px-5 font-archivo font-bold text-xs uppercase tracking-wider text-center">
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-slate-300"></span>
              Básica
            </span>
          </th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row, i) => (
          <tr class={`border-t border-custom-white/60 ${i % 2 === 0 ? 'bg-white' : 'bg-custom-surface/30'} ${row.feature.includes('Precio') ? 'bg-custom-blue/5 font-bold' : ''}`}>
            <td class="py-3.5 px-5 font-archivo font-semibold text-custom-black text-xs">{row.feature}</td>
            <td class="py-3.5 px-5 text-center text-xs text-custom-gray">
              <span class={row.premium.includes('✓') ? 'text-green-600 font-bold' : row.premium === '—' ? 'text-gray-300' : ''}>
                {row.premium}
              </span>
            </td>
            <td class="py-3.5 px-5 text-center text-xs text-custom-gray">
              <span class={row.exeplus.includes('✓') ? 'text-green-600 font-bold' : row.exeplus === '—' ? 'text-gray-300' : ''}>
                {row.exeplus}
              </span>
            </td>
            <td class="py-3.5 px-5 text-center text-xs text-custom-gray">
              <span class={row.basica.includes('✓') ? 'text-green-600 font-bold' : row.basica === '—' ? 'text-gray-300' : ''}>
                {row.basica}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Cards Mobile (3 columnas apiladas) -->
  <div class="md:hidden flex flex-col gap-4">
    {/* Premium */}
    <div class="rounded-2xl border-2 border-custom-gold/40 bg-gradient-to-br from-amber-50/60 to-white p-4 shadow-card-base">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2.5 h-2.5 rounded-full bg-custom-gold shadow-[0_0_8px_rgba(234,179,8,0.6)]"></span>
        <h3 class="font-archivo font-extrabold text-sm text-custom-black">★ Línea Premium</h3>
      </div>
      <ul class="space-y-2">
        {rows.map((row) => (
          <li class="flex justify-between items-start text-xs border-b border-custom-white/60 pb-2 last:border-none last:pb-0">
            <span class="font-semibold text-custom-black/80 w-[45%]">{row.feature}</span>
            <span class={`text-right w-[50%] ${row.premium.includes('✓') ? 'text-green-600 font-bold' : row.premium === '—' ? 'text-gray-300' : 'text-custom-gray'}`}>
              {row.premium}
            </span>
          </li>
        ))}
      </ul>
    </div>

    {/* Ejecutiva Plus */}
    <div class="rounded-2xl border border-custom-blue/20 bg-white p-4 shadow-card-base">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2.5 h-2.5 rounded-full bg-custom-original shadow-[0_0_8px_rgba(0,166,251,0.6)]"></span>
        <h3 class="font-archivo font-extrabold text-sm text-custom-black">Línea Ejecutiva Plus</h3>
      </div>
      <ul class="space-y-2">
        {rows.map((row) => (
          <li class="flex justify-between items-start text-xs border-b border-custom-white/60 pb-2 last:border-none last:pb-0">
            <span class="font-semibold text-custom-black/80 w-[45%]">{row.feature}</span>
            <span class={`text-right w-[50%] ${row.exeplus.includes('✓') ? 'text-green-600 font-bold' : row.exeplus === '—' ? 'text-gray-300' : 'text-custom-gray'}`}>
              {row.exeplus}
            </span>
          </li>
        ))}
      </ul>
    </div>

    {/* Básica */}
    <div class="rounded-2xl border border-custom-white/80 bg-white p-4 shadow-card-base">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2.5 h-2.5 rounded-full bg-slate-300"></span>
        <h3 class="font-archivo font-extrabold text-sm text-custom-black">Línea Básica</h3>
      </div>
      <ul class="space-y-2">
        {rows.map((row) => (
          <li class="flex justify-between items-start text-xs border-b border-custom-white/60 pb-2 last:border-none last:pb-0">
            <span class="font-semibold text-custom-black/80 w-[45%]">{row.feature}</span>
            <span class={`text-right w-[50%] ${row.basica.includes('✓') ? 'text-green-600 font-bold' : row.basica === '—' ? 'text-gray-300' : 'text-custom-gray'}`}>
              {row.basica}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- CTA -->
  <div class="text-center mt-8">
    <a
      href="/contacto"
      class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-custom-blue to-custom-original text-white text-sm font-archivo font-bold tracking-wide shadow-lg hover:shadow-xl hover:scale-[1.02] transition-all duration-200"
    >
      ¿Necesitás ayuda para elegir?
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
    </a>
  </div>
</section>
