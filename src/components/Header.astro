---
import Navbar from "./Navbar.astro";
---

<header
  id="site-header"
  class="fixed w-full top-0 left-0 z-40 transition-all duration-400"
>
  <div class="flex w-full justify-between items-center px-4 lg:px-8 py-3 lg:py-2">
    <!-- Logo -->
    <a class="flex items-center shrink-0" href="/" aria-label="Inicio — Pani Construcciones">
      <img
        width="220"
        height="60"
        class="h-11 lg:h-14 w-auto"
        src="/assets/icons/logo.webp"
        alt="Logo de Pani Construcciones"
      />
    </a>

    <!-- Eslogan centrado — solo desktop -->
    <p class="hidden lg:flex items-center gap-2 font-bold text-xs uppercase italic text-custom-blue tracking-widest select-none">
      <img src="https://flagcdn.com/w40/uy.png" alt="Uruguay" class="w-5 h-auto rounded-sm shadow-sm" />
      Construyendo a Uruguay hace 20 años
    </p>

    <!-- Favoritos mobile (centrado entre logo y hamburguesa) -->
    <div class="lg:hidden flex-1 flex justify-center relative">
      <button
        id="fav-mobile-btn"
        class="relative flex items-center justify-center p-2 text-custom-blue"
        aria-label="Ver favoritos"
        style="-webkit-tap-highlight-color: transparent;"
      >
        <svg class="w-6 h-6" fill="currentColor" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
        <span id="fav-mobile-count" class="absolute top-0.5 right-0.5 w-4 h-4 bg-red-500 text-white text-[9px] font-bold rounded-full flex items-center justify-center leading-none hidden">0</span>
      </button>

      <!-- Dropdown mobile favoritos -->
      <div id="fav-mobile-dropdown" class="absolute top-full right-0 mt-2 w-72 bg-white rounded-2xl shadow-2xl border border-custom-white/80 p-3 opacity-0 invisible pointer-events-none transition-all duration-200 translate-y-2 z-60">
        <p class="font-archivo font-bold text-xs text-custom-black uppercase tracking-wider mb-2 px-1">Mis favoritos</p>
        <div id="fav-mobile-list" class="max-h-64 overflow-y-auto space-y-1.5">
          <p class="text-xs text-custom-gray/50 italic px-1 py-3 text-center" id="fav-mobile-empty">No tenés proyectos guardados aún</p>
        </div>
      </div>
    </div>

    <!-- Hamburger + Nav -->
    <div class="flex items-center gap-2">
      <input class="hidden" type="checkbox" id="check" />
      <label
        class="cursor-pointer flex lg:hidden items-center justify-center p-2 text-custom-blue active:scale-95 transition-transform select-none bg-transparent border-none outline-none"
        style="-webkit-tap-highlight-color: transparent;"
        for="check"
        aria-label="Abrir menú"
      >
        <!-- Hamburger icon -->
        <svg
          id="menu"
          class="block"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          stroke-width="2.2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M4 6l16 0"></path>
          <path d="M4 12l16 0"></path>
          <path d="M4 18l16 0"></path>
        </svg>
        <!-- Close icon -->
        <svg
          id="close"
          class="hidden"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          stroke-width="2.2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M18 6l-12 12"></path>
          <path d="M6 6l12 12"></path>
        </svg>
      </label>
      <Navbar />
    </div>
  </div>
</header>

<script is:inline>
  // Glassmorphism al hacer scroll
  const header = document.getElementById("site-header");
  let ticking = false;

  function onScroll() {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        if (window.scrollY > 40) {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
        ticking = false;
      });
      ticking = true;
    }
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll(); // estado inicial
</script>
