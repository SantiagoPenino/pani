<!-- Botón flotante scroll to top -->
<button
  id="scroll-top-btn"
  aria-label="Volver arriba"
  class="fixed bottom-6 left-5 lg:bottom-8 lg:left-10 z-30 w-10 h-10 rounded-full bg-custom-blue/80 hover:bg-custom-blue text-white flex items-center justify-center shadow-lg backdrop-blur-sm transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/></svg>
</button>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("scroll-top-btn");
    if (!btn) return;

    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          if (window.scrollY > 400) {
            btn.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
            btn.classList.add("opacity-75", "translate-y-0", "pointer-events-auto");
          } else {
            btn.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
            btn.classList.remove("opacity-75", "translate-y-0", "pointer-events-auto");
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });
</script>
