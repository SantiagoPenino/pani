<!-- PWA Install Banner -->
<div id="install-banner" class="fixed bottom-0 left-0 right-0 z-50 translate-y-full transition-transform duration-500 ease-out" style="-webkit-tap-highlight-color: transparent;">
  <div class="mx-3 mb-3 bg-gradient-to-r from-custom-gray via-custom-blue-dark to-custom-blue rounded-2xl shadow-2xl border border-white/10 p-4 flex items-center gap-4">
    <img src="/assets/icons/512.png" alt="Pani" class="w-14 h-14 shrink-0" />
    <div class="flex-1 min-w-0">
      <p class="font-archivo font-bold text-white text-sm leading-tight">Instalá la app</p>
      <p class="text-white/60 text-xs mt-0.5">Acceso rápido y navegá offline</p>
    </div>
    <button id="install-accept" class="shrink-0 px-4 py-2 bg-white text-custom-blue font-archivo font-bold text-xs rounded-full hover:bg-white/90 transition-colors active:scale-95">
      Instalar
    </button>
    <button id="install-dismiss" class="shrink-0 p-1 text-white/50 hover:text-white transition-colors" aria-label="Cerrar">
      <svg width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
</div>

<script is:inline>
  let deferredPrompt = null;

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;

    // Don't show if user already dismissed
    if (localStorage.getItem('pani-install-dismissed')) return;
    // Don't show if already installed (standalone mode)
    if (window.matchMedia('(display-mode: standalone)').matches) return;

    // Show banner after 5 seconds
    setTimeout(() => {
      const banner = document.getElementById('install-banner');
      if (banner) {
        banner.classList.remove('translate-y-full');
        banner.classList.add('translate-y-0');
      }
    }, 5000);
  });

  document.addEventListener('click', (e) => {
    const accept = e.target.closest('#install-accept');
    const dismiss = e.target.closest('#install-dismiss');
    const banner = document.getElementById('install-banner');

    if (accept && deferredPrompt) {
      deferredPrompt.prompt();
      deferredPrompt.userChoice.then(() => {
        deferredPrompt = null;
        if (banner) {
          banner.classList.remove('translate-y-0');
          banner.classList.add('translate-y-full');
        }
      });
    }

    if (dismiss) {
      localStorage.setItem('pani-install-dismissed', '1');
      if (banner) {
        banner.classList.remove('translate-y-0');
        banner.classList.add('translate-y-full');
      }
    }
  });
</script>
