---
const { src, alt } = Astro.props;
---

<div class="relative group cursor-pointer">
  <div class="overflow-hidden rounded-xl shadow-card-base">
    <img
      class="toggle-modal w-full h-auto object-cover transition-transform duration-500 group-hover:scale-105"
      width="476"
      height="268"
      src={src}
      alt={alt}
      loading="lazy"
    />
    <!-- Hover hint -->
    <div class="absolute inset-0 bg-custom-black/0 group-hover:bg-custom-black/30 transition-colors duration-300 rounded-xl flex items-center justify-center pointer-events-none">
      <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-white/20 backdrop-blur-sm text-white text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border border-white/30">
        Ampliar
      </span>
    </div>
  </div>

  <!-- Modal backdrop -->
  <div
    class="modal-backdrop w-screen h-screen fixed inset-0 bg-black/85 backdrop-blur-sm z-50 flex items-center justify-center hidden"
    style="margin: 0;"
  >
    <!-- Cerrar -->
    <button
      class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors z-10"
      aria-label="Cerrar imagen"
      id="modal-close-btn"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <div class="modal-content flex items-center justify-center p-4 w-full h-full">
      <img
        width="1366"
        height="768"
        src={src}
        alt={alt}
        class="modal-image max-w-full max-h-[90vh] w-auto h-auto rounded-xl shadow-2xl transition-all duration-300 transform scale-0 object-contain"
      />
    </div>
  </div>
</div>

<script is:inline data-astro-rerun>
  document.addEventListener("astro:page-load", () => {
    const modalElements = document.querySelectorAll(".toggle-modal");

    modalElements.forEach((modalElement) => {
      const wrapper = modalElement.closest(".relative");
      if (!wrapper) return;
      // Extraer el modal y moverlo al final del body para escapar del contexto de apilamiento
      // que genera el transform de .reveal y que rompe el position: fixed
      let modal = wrapper.querySelector(".modal-backdrop");
      if (modal) {
        document.body.appendChild(modal);
      } else {
        // En caso de que ya se haya movido previamente (ej: view transitions)
        // buscamos si hay algún modal que le corresponda a esta imagen
        // Para simplificar, asumimos que cada click abre su respectivo modal movido
        // Como movemos todos al body, la variable modal que captura al inicio es clave
      }
      
      const modalImage = modal?.querySelector(".modal-image");
      if (!modal || !modalImage) return;

      function openModal() {
        modal.classList.remove("hidden");
        document.body.style.overflow = "hidden";
        setTimeout(() => {
          modalImage.classList.remove("scale-0");
          modalImage.classList.add("scale-100");
        }, 10);
      }

      function closeModal() {
        modalImage.classList.remove("scale-100");
        modalImage.classList.add("scale-0");
        setTimeout(() => {
          modal.classList.add("hidden");
          document.body.style.overflow = "";
        }, 250);
      }

      modalElement.addEventListener("click", openModal);

      modal.addEventListener("click", (e) => {
        if (e.target === modal || e.target.closest(".modal-content")) {
          closeModal();
        }
      });

      const closeBtn = modal.querySelector("#modal-close-btn");
      closeBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        closeModal();
      });

      // Esc para cerrar
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.classList.contains("hidden")) {
          closeModal();
        }
      });
    });
  });
</script>
