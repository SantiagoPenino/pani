---
const { src, alt, noOverlay = false } = Astro.props;
---

<div class="relative group cursor-pointer">
  <div class="overflow-hidden rounded-xl shadow-card-base aspect-video w-full">
    <img
      class="toggle-modal w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      width="476"
      height="268"
      src={src}
      alt={alt}
      loading="lazy"
    />
    <!-- Hover hint -->
    <div class={`absolute inset-0 transition-colors duration-300 rounded-xl flex items-center justify-center pointer-events-none ${noOverlay ? '' : 'bg-custom-black/0 group-hover:bg-custom-black/30'}`}>
      <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-white/20 backdrop-blur-sm text-white text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border border-white/30">
        Ampliar
      </span>
    </div>
  </div>

  <!-- Modal backdrop -->
  <div
    class="modal-backdrop w-screen h-screen fixed inset-0 bg-black/85 backdrop-blur-sm z-50 flex items-center justify-center hidden"
    style="margin: 0;"
  >
    <!-- Cerrar -->
    <button
      type="button"
      class="modal-close absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors z-10"
      aria-label="Cerrar imagen"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <div class="modal-content flex items-center justify-center p-4 w-full h-full">
      <img
        width="1366"
        height="768"
        src={src}
        alt={alt}
        class="modal-image max-w-full max-h-[90vh] w-auto h-auto rounded-xl shadow-2xl transition-all duration-300 transform scale-0 object-contain"
      />
    </div>
  </div>
</div>

<script is:inline>
  // Los modales se mueven al final del <body> para escapar del stacking context que
  // genera el transform de .reveal (rompe el position: fixed). Este script se renderiza
  // una vez por imagen y con ViewTransitions no se re-ejecuta al navegar, así que cada
  // imagen se vincula una sola vez en cada página nueva y los listeners sobre document
  // se registran una única vez para que no se acumulen entre navegaciones.
  (() => {
    function openModal(modal) {
      const image = modal.querySelector(".modal-image");
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      setTimeout(() => {
        image?.classList.remove("scale-0");
        image?.classList.add("scale-100");
      }, 10);
    }

    function closeModal(modal) {
      const image = modal.querySelector(".modal-image");
      image?.classList.remove("scale-100");
      image?.classList.add("scale-0");
      setTimeout(() => {
        modal.classList.add("hidden");
        document.body.style.overflow = "";
      }, 250);
    }

    function bindModals() {
      document.querySelectorAll(".toggle-modal").forEach((img) => {
        if (img.dataset.modalBound) return;
        const modal = img.closest(".relative")?.querySelector(".modal-backdrop");
        if (!modal) return;
        img.dataset.modalBound = "true";
        document.body.appendChild(modal);

        img.addEventListener("click", () => openModal(modal));
        modal.addEventListener("click", (e) => {
          const target = e.target instanceof Element ? e.target : null;
          if (e.target === modal || target?.closest(".modal-content") || target?.closest(".modal-close")) {
            closeModal(modal);
          }
        });
      });
    }

    if (!window.__paniModalBound) {
      window.__paniModalBound = true;
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const open = document.querySelector(".modal-backdrop:not(.hidden)");
        if (open) closeModal(open);
      });
      document.addEventListener("DOMContentLoaded", bindModals);
      document.addEventListener("astro:after-swap", bindModals);
    }

    // Al llegar por ViewTransitions desde una página sin modales este script se ejecuta
    // después de astro:after-swap, así que se vinculan igual los ya presentes.
    bindModals();
  })();
</script>
