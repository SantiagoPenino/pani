---
import CallToAction from "./CallToAction.astro";
---

<div class="contact my-8 lg:my-14 rounded-2xl overflow-hidden py-12 lg:py-16 px-5 lg:px-10 flex flex-col items-center justify-center text-center min-h-[360px]">

  <div class="reveal">
    <span class="section-badge mb-4 bg-white/15 border border-white/20 backdrop-blur-sm inline-flex">
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
        <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
        <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
      </svg>
      ¿Tienes alguna consulta?
    </span>

    <p class="font-archivo font-extrabold text-white text-2xl sm:text-3xl lg:text-4xl leading-tight mb-2">
      ¡No dudes en<br class="sm:hidden" /> contactarnos!
    </p>
    <p class="text-white/70 text-sm sm:text-base mb-8 max-w-md mx-auto">
      Nuestro equipo está listo para ayudarte a planificar tu proyecto ideal.
    </p>
  </div>

  <!-- Servicios con íconos -->
  <div class="reveal reveal-delay-2 w-full max-w-2xl mb-10">
    <p class="text-white/90 text-xs font-bold uppercase tracking-widest mb-4">Servicios que ofrecemos</p>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-left">
      {[
        { icon: "🏠", text: "Construcción de viviendas desde cero." },
        { icon: "📐", text: "Ampliaciones en planta baja y planta alta." },
        { icon: "🏘️", text: "Casas apareadas / Dúplex." },
        { icon: "🏭", text: "Depósitos, galpones o locales comerciales." },
        { icon: "🤝", text: "Viviendas tipo Cooperativas." },
        { icon: "🔨", text: "Renovaciones y remodelaciones." },
        { icon: "✏️", text: "Proyectos arquitectónicos personalizados." },
      ].map(({ icon, text }) => (
        <li class="flex items-start gap-2.5 bg-white/10 backdrop-blur-sm rounded-xl px-3.5 py-2.5 border border-white/15">
          <span class="text-base leading-5 shrink-0">{icon}</span>
          <span class="text-white/85 text-xs sm:text-sm font-medium leading-snug">{text}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- CTAs -->
  <div class="reveal reveal-delay-3 flex flex-col sm:flex-row gap-3 items-center">
    <CallToAction />
    <a
      href="https://wa.me/598099491227"
      target="_blank"
      rel="noopener noreferrer"
      id="contact-whatsapp-btn"
      class="inline-flex items-center gap-2 bg-custom-green hover:bg-custom-whatsapp text-white font-archivo font-bold text-sm uppercase px-7 py-3.5 rounded-full transition-all duration-200 hover:scale-105 shadow-lg"
    >
      <svg class="w-5 h-5" viewBox="0 0 448 512">
        <path fill="currentColor" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
      </svg>
      WhatsApp
    </a>
  </div>
</div>
