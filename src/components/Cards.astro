---
interface Props {
  code: string;
  imgAlt: string;
  price: string;
  size: string;
  bedrooms: string;
  bathrooms: string;
  category: string;
  line?: string;
}

const { code, imgAlt, price, size, bedrooms, bathrooms, category, line } = Astro.props;
const isPremium = category === "premium" || line === "Premium";
---

<article class="project-card reveal">
  <a href={`/${code}`} class="block" aria-label={`Ver proyecto ${code} — ${size}m²`}>

    <!-- Imagen con overlay hover -->
    <div class="card-img-wrap">
      <img
        width="476"
        height="268"
        src={`/assets/images/proyectos/${category}/${code}.webp`}
        alt={imgAlt}
        loading={category !== "premium" && category !== "isopanel" ? "lazy" : "eager"}
      />

      <!-- Overlay que aparece al hover -->
      <div class="card-overlay" aria-hidden="true">
        <div class="flex items-center gap-2 w-full">
          {isPremium && (
            <span class="line-badge gold text-xs">Premium</span>
          )}
          <span class="text-white font-bold text-sm ml-auto flex items-center gap-1">
            Ver proyecto
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
        </div>
      </div>
    </div>

    <!-- Barra de info -->
    <div class="card-info-bar">
      <!-- Precio -->
      <div class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-custom-original shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="font-bold text-sm">U$S {price}</span>
      </div>

      <!-- Specs -->
      <div class="flex items-center gap-2.5 text-sm text-white/85">
        <span class="font-semibold">{size}m²</span>

        <span class="w-px h-4 bg-custom-blue/60 block"></span>

        <!-- Dormitorios -->
        <span class="flex items-center gap-1">
          {bedrooms}
          <svg class="h-3.5 w-auto" viewBox="0 0 640 512">
            <path fill="currentColor" d="M32 32c17.7 0 32 14.3 32 32V320H288V160c0-17.7 14.3-32 32-32H544c53 0 96 43 96 96V448c0 17.7-14.3 32-32 32s-32-14.3-32-32V416H352 320 64v32c0 17.7-14.3 32-32 32s-32-14.3-32-32V64C0 46.3 14.3 32 32 32zm144 96a80 80 0 1 1 0 160 80 80 0 1 1 0-160z"/>
          </svg>
        </span>

        <span class="w-px h-4 bg-custom-blue/60 block"></span>

        <!-- Baños -->
        <span class="flex items-center gap-1">
          {bathrooms}
          <svg class="h-3.5 w-auto" viewBox="0 0 512 512">
            <path fill="currentColor" d="M64 131.9C64 112.1 80.1 96 99.9 96c9.5 0 18.6 3.8 25.4 10.5l16.2 16.2c-21 38.9-17.4 87.5 10.9 123L151 247c-9.4 9.4-9.4 24.6 0 33.9s24.6 9.4 33.9 0L345 121c9.4-9.4 9.4-24.6 0-33.9s-24.6-9.4-33.9 0l-1.3 1.3c-35.5-28.3-84.2-31.9-123-10.9L170.5 61.3C151.8 42.5 126.4 32 99.9 32C44.7 32 0 76.7 0 131.9V448c0 17.7 14.3 32 32 32s32-14.3 32-32V131.9zM256 352a32 32 0 1 0 0-64 32 32 0 1 0 0 64zm64 64a32 32 0 1 0 -64 0 32 32 0 1 0 64 0zm0-128a32 32 0 1 0 0-64 32 32 0 1 0 0 64zm64 64a32 32 0 1 0 -64 0 32 32 0 1 0 64 0zm0-128a32 32 0 1 0 0-64 32 32 0 1 0 0 64zm64 64a32 32 0 1 0 -64 0 32 32 0 1 0 64 0zm32-32a32 32 0 1 0 0-64 32 32 0 1 0 0 64z"/>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>