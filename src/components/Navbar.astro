---
import CallToAction from "./CallToAction.astro";
---

<nav
  id="navbar"
  class="absolute overflow-hidden w-full h-0 top-full left-0 lg:top-0 lg:w-auto bg-white lg:bg-transparent lg:h-auto lg:relative lg:flex z-50"
>
  <ul
    class="flex flex-col h-full lg:flex-row lg:gap-6 justify-center lg:justify-end items-center text-base uppercase lg:normal-case py-16 lg:py-0 px-4 lg:px-0 text-center"
  >
    <li class="flex-1 w-full lg:flex-none lg:w-auto relative group">
      <a
        class="block py-3 lg:py-1 font-bold text-sm tracking-wide text-custom-gray lg:text-custom-gray hover:text-custom-blue transition-colors duration-200"
        href="/#steelframing"
      >
        Steel Framing
      </a>
      <span
        class="hidden lg:block absolute bottom-[-2px] left-0 right-0 h-[2px] bg-gradient-to-r from-custom-blue to-custom-original scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center rounded-full"
      ></span>
    </li>
    <li class="flex-1 w-full lg:flex-none lg:w-auto relative group">
      <a
        class="block py-3 lg:py-1 font-bold text-sm tracking-wide text-custom-gray lg:text-custom-gray hover:text-custom-blue transition-colors duration-200"
        href="/isopanel"
      >
        Isopanel
      </a>
      <span
        class="hidden lg:block absolute bottom-[-2px] left-0 right-0 h-[2px] bg-gradient-to-r from-custom-blue to-custom-original scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center rounded-full"
      ></span>
    </li>
    <li class="flex-1 w-full lg:flex-none lg:w-auto relative group">
      <a
        class="block py-3 lg:py-1 font-bold text-sm tracking-wide text-custom-gray lg:text-custom-gray hover:text-custom-blue transition-colors duration-200"
        href="/obras"
      >
        Obras realizadas
      </a>
      <span
        class="hidden lg:block absolute bottom-[-2px] left-0 right-0 h-[2px] bg-gradient-to-r from-custom-blue to-custom-original scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center rounded-full"
      ></span>
    </li>
    <li class="flex-1 w-full lg:flex-none lg:w-auto mt-4 lg:mt-0 lg:ml-2">
      <CallToAction />
    </li>
  </ul>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const checkbox = document.getElementById("check");
    const navbarLinks = document.querySelectorAll("#navbar a");

    navbarLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (checkbox instanceof HTMLInputElement) {
          checkbox.checked = false;
        }
      });
    });
  });
</script>
