---
import CallToAction from "./CallToAction.astro";
---

<!-- Desktop nav (unchanged) -->
<nav
  id="navbar-desktop"
  class="hidden lg:flex lg:overflow-visible lg:h-full lg:relative z-50"
>
  <ul class="flex lg:flex-row lg:gap-6 lg:justify-end items-center lg:overflow-visible">
    <!-- Steel Framing Desktop -->
    <li class="relative group py-1">
      <a
        class="inline-flex items-center gap-1.5 font-archivo text-sm font-bold text-custom-gray hover:text-custom-blue normal-case transition-colors duration-200"
        href="/#steelframing"
      >
        Steel Framing
        <svg class="w-3.5 h-3.5 text-custom-gray/60 group-hover:text-custom-blue group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
      <span class="absolute bottom-[-2px] left-0 right-0 h-[2px] bg-gradient-to-r from-custom-blue to-custom-original scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center rounded-full"></span>
      <div class="nav-dropdown pt-2">
        <div class="bg-white rounded-2xl shadow-header-glass border border-custom-white/80 p-2 min-w-[200px] text-left">
          <a href="/#sf-premium" class="flex items-center gap-2.5 px-3.5 py-2.5 text-xs font-semibold text-custom-gray hover:text-custom-gold hover:bg-custom-surface rounded-xl transition-colors">
            <span class="w-2 h-2 rounded-full bg-custom-gold shrink-0"></span>
            ★ Línea Premium
          </a>
          <a href="/#sf-exeplus" class="flex items-center gap-2.5 px-3.5 py-2.5 text-xs font-semibold text-custom-gray hover:text-custom-blue hover:bg-custom-surface rounded-xl transition-colors">
            <span class="w-2 h-2 rounded-full bg-custom-blue shrink-0"></span>
            Línea Ejecutiva Plus
          </a>
          <a href="/#sf-basic" class="flex items-center gap-2.5 px-3.5 py-2.5 text-xs font-semibold text-custom-gray hover:text-custom-original hover:bg-custom-surface rounded-xl transition-colors">
            <span class="w-2 h-2 rounded-full bg-custom-original shrink-0"></span>
            Línea Básica
          </a>
        </div>
      </div>
    </li>

    <!-- Isopanel Desktop -->
    <li class="relative group py-1">
      <a
        class="inline-flex items-center gap-1.5 font-archivo text-sm font-bold text-custom-gray hover:text-custom-blue normal-case transition-colors duration-200"
        href="/isopanel"
      >
        Isopanel
        <svg class="w-3.5 h-3.5 text-custom-gray/60 group-hover:text-custom-blue group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
      <span class="absolute bottom-[-2px] left-0 right-0 h-[2px] bg-gradient-to-r from-custom-blue to-custom-original scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center rounded-full"></span>
      <div class="nav-dropdown pt-2">
        <div class="bg-white rounded-2xl shadow-header-glass border border-custom-white/80 p-2 min-w-[200px] text-left">
          <a href="/isopanel#iso-premium" class="flex items-center gap-2.5 px-3.5 py-2.5 text-xs font-semibold text-custom-gray hover:text-custom-gold hover:bg-custom-surface rounded-xl transition-colors">
            <span class="w-2 h-2 rounded-full bg-custom-gold shrink-0"></span>
            ★ Línea Premium
          </a>
          <a href="/isopanel#iso-exeplus" class="flex items-center gap-2.5 px-3.5 py-2.5 text-xs font-semibold text-custom-gray hover:text-custom-blue hover:bg-custom-surface rounded-xl transition-colors">
            <span class="w-2 h-2 rounded-full bg-custom-blue shrink-0"></span>
            Línea Ejecutiva Plus
          </a>
          <a href="/isopanel#iso-basic" class="flex items-center gap-2.5 px-3.5 py-2.5 text-xs font-semibold text-custom-gray hover:text-custom-original hover:bg-custom-surface rounded-xl transition-colors">
            <span class="w-2 h-2 rounded-full bg-custom-original shrink-0"></span>
            Línea Básica
          </a>
        </div>
      </div>
    </li>

    <!-- Obras realizadas Desktop -->
    <li class="relative group py-1">
      <a class="block font-archivo text-sm font-bold text-custom-gray hover:text-custom-blue normal-case transition-colors duration-200" href="/obras">
        Obras realizadas
      </a>
      <span class="absolute bottom-[-2px] left-0 right-0 h-[2px] bg-gradient-to-r from-custom-blue to-custom-original scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center rounded-full"></span>
    </li>

    <!-- Favoritos Desktop -->
    <li class="relative py-1" id="fav-nav-item">
      <button
        id="fav-nav-btn"
        class="relative flex items-center justify-center text-custom-blue hover:text-custom-original transition-colors duration-200 p-1"
        aria-label="Ver favoritos"
      >
        <svg class="w-5 h-5" fill="currentColor" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
        <span id="fav-count" class="absolute -top-1 -right-1.5 w-4 h-4 bg-red-500 text-white text-[9px] font-bold rounded-full flex items-center justify-center leading-none hidden">0</span>
      </button>

      <!-- Dropdown de favoritos -->
      <div id="fav-dropdown" class="absolute top-full right-0 mt-2 w-72 bg-white rounded-2xl shadow-header-glass border border-custom-white/80 p-3 opacity-0 invisible pointer-events-none transition-all duration-200 translate-y-2 z-60">
        <p class="font-archivo font-bold text-xs text-custom-black uppercase tracking-wider mb-2 px-1">Mis favoritos</p>
        <div id="fav-list" class="max-h-64 overflow-y-auto space-y-1.5">
          <p class="text-xs text-custom-gray/50 italic px-1 py-3 text-center" id="fav-empty">No tenés proyectos guardados aún</p>
        </div>
      </div>
    </li>

    <li class="ml-2">
      <CallToAction />
    </li>
  </ul>
</nav>

<!-- Mobile Slide-In Drawer -->
<div id="mobile-overlay" class="lg:hidden fixed inset-0 bg-black/50 z-40 opacity-0 pointer-events-none transition-opacity duration-300" style="-webkit-tap-highlight-color: transparent;"></div>

<nav
  id="navbar"
  class="lg:hidden fixed top-0 right-0 h-full w-[60%] max-w-[320px] z-50 translate-x-full transition-transform duration-300 ease-[cubic-bezier(.4,0,.2,1)] overflow-y-auto"
  style="background: linear-gradient(180deg, #0d2d42 0%, #0a3d5c 50%, #0d2d42 100%);"
>
  <div class="flex flex-col px-5 py-6 min-h-full">
    <!-- Close button -->
    <div class="flex justify-end mb-4">
      <button id="drawer-close" class="p-1 text-white/70 hover:text-white transition-colors" style="-webkit-tap-highlight-color: transparent;" aria-label="Cerrar menú">
        <svg width="24" height="24" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6l-12 12"></path>
          <path d="M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Steel Framing -->
    <p class="font-archivo font-extrabold text-[11px] text-white/50 tracking-[0.2em] uppercase mb-3">Steel Framing</p>
    <a href="/#sf-premium" class="nav-drawer-link flex items-center gap-2.5 px-3 py-3.5 rounded-xl hover:bg-white/10 text-xs font-archivo font-bold text-custom-gold transition-colors active:bg-white/15">
      <span class="w-2 h-2 rounded-full bg-custom-gold shadow-[0_0_8px_rgba(234,179,8,0.8)] shrink-0"></span>
      ★ Línea Premium
    </a>
    <a href="/#sf-exeplus" class="nav-drawer-link flex items-center gap-2.5 px-3 py-3.5 rounded-xl hover:bg-white/10 text-xs font-archivo font-semibold text-white transition-colors active:bg-white/15">
      <span class="w-2 h-2 rounded-full bg-custom-original shadow-[0_0_8px_rgba(0,166,251,0.8)] shrink-0"></span>
      Línea Ejecutiva Plus
    </a>
    <a href="/#sf-basic" class="nav-drawer-link flex items-center gap-2.5 px-3 py-3.5 rounded-xl hover:bg-white/10 text-xs font-archivo font-semibold text-white/80 transition-colors active:bg-white/15">
      <span class="w-2 h-2 rounded-full bg-slate-300 shrink-0"></span>
      Línea Básica
    </a>

    <div class="h-px bg-white/10 my-5"></div>

    <!-- Isopanel -->
    <p class="font-archivo font-extrabold text-[11px] text-white/50 tracking-[0.2em] uppercase mb-3">Isopanel</p>
    <a href="/isopanel#iso-premium" class="nav-drawer-link flex items-center gap-2.5 px-3 py-3.5 rounded-xl hover:bg-white/10 text-xs font-archivo font-bold text-custom-gold transition-colors active:bg-white/15">
      <span class="w-2 h-2 rounded-full bg-custom-gold shadow-[0_0_8px_rgba(234,179,8,0.8)] shrink-0"></span>
      ★ Línea Premium
    </a>
    <a href="/isopanel#iso-exeplus" class="nav-drawer-link flex items-center gap-2.5 px-3 py-3.5 rounded-xl hover:bg-white/10 text-xs font-archivo font-semibold text-white transition-colors active:bg-white/15">
      <span class="w-2 h-2 rounded-full bg-custom-original shadow-[0_0_8px_rgba(0,166,251,0.8)] shrink-0"></span>
      Línea Ejecutiva Plus
    </a>
    <a href="/isopanel#iso-basic" class="nav-drawer-link flex items-center gap-2.5 px-3 py-3.5 rounded-xl hover:bg-white/10 text-xs font-archivo font-semibold text-white/80 transition-colors active:bg-white/15">
      <span class="w-2 h-2 rounded-full bg-slate-300 shrink-0"></span>
      Línea Básica
    </a>

    <div class="h-px bg-white/10 my-5"></div>

    <!-- Obras Realizadas -->
    <a href="/obras" class="nav-drawer-link flex items-center gap-2.5 px-3 py-3.5 rounded-xl hover:bg-white/10 text-sm font-archivo font-extrabold text-white tracking-wider transition-colors active:bg-white/15">
      Obras realizadas
    </a>

    <!-- Contacto -->
    <div class="mt-auto pt-6">
      <a
        href="/contacto"
        class="nav-drawer-link flex items-center justify-center gap-2 w-full py-3 rounded-full border border-white/40 text-xs font-archivo font-bold text-white tracking-wider hover:bg-white/10 hover:border-white/60 transition-all active:scale-95"
      >
        CONTACTO
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  function setupDrawer() {
    const checkbox = document.getElementById("check");
    const overlay = document.getElementById("mobile-overlay");
    const drawer = document.getElementById("navbar");
    const closeBtn = document.getElementById("drawer-close");

    if (!drawer || !overlay) return;

    // Move overlay & drawer to <body> so fixed positioning works
    // (escapes header's backdrop-filter containing block)
    if (drawer.parentElement !== document.body) {
      document.body.appendChild(overlay);
      document.body.appendChild(drawer);
    }

    const drawerLinks = drawer.querySelectorAll(".nav-drawer-link");

    function openDrawer() {
      drawer.classList.remove("translate-x-full");
      drawer.classList.add("translate-x-0");
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "hidden";
    }

    function closeDrawer() {
      drawer.classList.remove("translate-x-0");
      drawer.classList.add("translate-x-full");
      overlay.classList.remove("opacity-100", "pointer-events-auto");
      overlay.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = "";
      if (checkbox instanceof HTMLInputElement) checkbox.checked = false;
    }

    // Open via hamburger checkbox
    if (checkbox) {
      checkbox.addEventListener("change", () => {
        if (checkbox.checked) openDrawer();
        else closeDrawer();
      });
    }

    // Close via overlay tap
    overlay.addEventListener("click", closeDrawer);

    // Close via X button
    if (closeBtn) closeBtn.addEventListener("click", closeDrawer);

    // Close on link click
    drawerLinks.forEach((link) => {
      link.addEventListener("click", closeDrawer);
    });
  }

  document.addEventListener("DOMContentLoaded", setupDrawer);
  document.addEventListener("astro:page-load", setupDrawer);

  // ── Favorites dropdown ──
  function setupFavDropdown() {
    const btn = document.getElementById("fav-nav-btn");
    const dropdown = document.getElementById("fav-dropdown");
    const favList = document.getElementById("fav-list");
    const favEmpty = document.getElementById("fav-empty");
    const favCount = document.getElementById("fav-count");
    if (!btn || !dropdown) return;

    let isOpen = false;

    function renderFavs() {
      const favs = JSON.parse(localStorage.getItem("pani-favs") || "[]");

      // Update counter badges (desktop + mobile)
      [favCount, document.getElementById("fav-mobile-count")].forEach(badge => {
        if (!badge) return;
        if (favs.length > 0) {
          badge.textContent = favs.length;
          badge.classList.remove("hidden");
          badge.classList.add("flex");
        } else {
          badge.classList.add("hidden");
          badge.classList.remove("flex");
        }
      });

      if (!favList || !favEmpty) return;

      if (favs.length === 0) {
        favEmpty.classList.remove("hidden");
        // Remove old project items
        favList.querySelectorAll(".fav-item").forEach(el => el.remove());
        return;
      }

      favEmpty.classList.add("hidden");
      // Remove old items
      favList.querySelectorAll(".fav-item").forEach(el => el.remove());

      favs.forEach(code => {
        const item = document.createElement("a");
        item.href = "/" + code;
        item.className = "fav-item flex items-center gap-3 p-2 rounded-xl hover:bg-custom-surface/60 transition-colors group";
        item.innerHTML = `
          <img src="/assets/images/proyectos/sf-premium/${code}/1.webp"
               onerror="this.src='/assets/images/proyectos/sf-exeplus/${code}/1.webp';this.onerror=function(){this.src='/assets/images/proyectos/sf-basic/${code}/1.webp';this.onerror=function(){this.src='/assets/images/proyectos/iso-premium/${code}/1.webp';this.onerror=function(){this.src='/assets/images/proyectos/iso-exeplus/${code}/1.webp';this.onerror=function(){this.src='/assets/images/proyectos/iso-basic/${code}/1.webp';this.onerror=null}}}};"
               alt="${code}" class="w-12 h-12 rounded-lg object-cover shrink-0" />
          <div class="flex-1 min-w-0">
            <p class="font-archivo font-bold text-xs text-custom-black leading-tight">Proyecto ${code}</p>
            <p class="text-[10px] text-custom-gray/50 mt-0.5">Ver detalles →</p>
          </div>
          <button class="fav-remove shrink-0 p-1 text-gray-300 hover:text-red-500 transition-colors" data-code="${code}" aria-label="Quitar favorito" onclick="event.preventDefault();event.stopPropagation();">
            <svg width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        `;
        // Remove button handler
        item.querySelector(".fav-remove").addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const c = e.currentTarget.dataset.code;
          let f = JSON.parse(localStorage.getItem("pani-favs") || "[]");
          f = f.filter(x => x !== c);
          localStorage.setItem("pani-favs", JSON.stringify(f));
          if (window.syncFavButtons) window.syncFavButtons();
          renderFavs();
        });
        favList.appendChild(item);
      });
    }

    function openDropdown() {
      renderFavs();
      dropdown.classList.remove("opacity-0", "invisible", "pointer-events-none", "translate-y-2");
      dropdown.classList.add("opacity-100", "visible", "pointer-events-auto", "translate-y-0");
      isOpen = true;
    }

    function closeDropdown() {
      dropdown.classList.add("opacity-0", "invisible", "pointer-events-none", "translate-y-2");
      dropdown.classList.remove("opacity-100", "visible", "pointer-events-auto", "translate-y-0");
      isOpen = false;
    }

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeDropdown();
      } else {
        // Reset mobile styles
        dropdown.style.position = "";
        dropdown.style.top = "";
        dropdown.style.right = "";
        dropdown.style.left = "";
        dropdown.style.width = "";
        openDropdown();
      }
    });

    document.addEventListener("click", (e) => {
      if (isOpen && !dropdown.contains(e.target) && !btn.contains(e.target)) {
        closeDropdown();
      }
    });

    // Mobile fav button - uses its own dropdown in Header
    const mobileBtn = document.getElementById("fav-mobile-btn");
    const mobileDropdown = document.getElementById("fav-mobile-dropdown");
    const mobileList = document.getElementById("fav-mobile-list");
    const mobileEmpty = document.getElementById("fav-mobile-empty");
    let mobileOpen = false;

    function renderMobileFavs() {
      if (!mobileList || !mobileEmpty) return;
      const favs = JSON.parse(localStorage.getItem("pani-favs") || "[]");
      mobileList.querySelectorAll(".fav-item").forEach(el => el.remove());
      if (favs.length === 0) {
        mobileEmpty.classList.remove("hidden");
        return;
      }
      mobileEmpty.classList.add("hidden");
      favs.forEach(code => {
        const item = document.createElement("a");
        item.href = "/" + code;
        item.className = "fav-item flex items-center gap-3 p-2 rounded-xl hover:bg-custom-surface/60 transition-colors";
        item.innerHTML = `
          <img src="/assets/images/proyectos/sf-premium/${code}/1.webp"
               onerror="this.src='/assets/images/proyectos/sf-exeplus/${code}/1.webp';this.onerror=function(){this.src='/assets/images/proyectos/sf-basic/${code}/1.webp';this.onerror=function(){this.src='/assets/images/proyectos/iso-premium/${code}/1.webp';this.onerror=function(){this.src='/assets/images/proyectos/iso-exeplus/${code}/1.webp';this.onerror=function(){this.src='/assets/images/proyectos/iso-basic/${code}/1.webp';this.onerror=null}}}};"
               alt="${code}" class="w-12 h-12 rounded-lg object-cover shrink-0" />
          <div class="flex-1 min-w-0">
            <p class="font-archivo font-bold text-xs text-custom-black leading-tight">Proyecto ${code}</p>
            <p class="text-[10px] text-custom-gray/50 mt-0.5">Ver detalles →</p>
          </div>
          <button class="fav-remove shrink-0 p-1 text-gray-300 hover:text-red-500 transition-colors" data-code="${code}" aria-label="Quitar favorito" onclick="event.preventDefault();event.stopPropagation();">
            <svg width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        `;
        item.querySelector(".fav-remove").addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          const c = e.currentTarget.dataset.code;
          let f = JSON.parse(localStorage.getItem("pani-favs") || "[]");
          f = f.filter(x => x !== c);
          localStorage.setItem("pani-favs", JSON.stringify(f));
          if (window.syncFavButtons) window.syncFavButtons();
          renderFavs();
          renderMobileFavs();
        });
        mobileList.appendChild(item);
      });
    }

    function openMobile() {
      if (!mobileDropdown) return;
      renderMobileFavs();
      mobileDropdown.classList.remove("opacity-0", "invisible", "pointer-events-none", "translate-y-2");
      mobileDropdown.classList.add("opacity-100", "visible", "pointer-events-auto", "translate-y-0");
      mobileOpen = true;
    }

    function closeMobile() {
      if (!mobileDropdown) return;
      mobileDropdown.classList.add("opacity-0", "invisible", "pointer-events-none", "translate-y-2");
      mobileDropdown.classList.remove("opacity-100", "visible", "pointer-events-auto", "translate-y-0");
      mobileOpen = false;
    }

    if (mobileBtn) {
      mobileBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        mobileOpen ? closeMobile() : openMobile();
      });
    }

    document.addEventListener("click", (e) => {
      if (mobileOpen && mobileDropdown && !mobileDropdown.contains(e.target) && !mobileBtn?.contains(e.target)) {
        closeMobile();
      }
    });

    // Listen for fav changes to update mobile dropdown too
    window.addEventListener("favs-changed", renderMobileFavs);

    // Initial badge update
    renderFavs();

    // Listen for real-time fav changes from heart buttons
    window.addEventListener("favs-changed", renderFavs);
  }

  document.addEventListener("DOMContentLoaded", setupFavDropdown);
  document.addEventListener("astro:page-load", setupFavDropdown);
</script>

