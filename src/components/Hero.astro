---
/**
 * Hero de la portada. Basado en la referencia de diseño (hero desktop / hero mobile):
 * estructura de steel framing a la izquierda, casa a la derecha y, al centro, logo,
 * eslogan, titular, cinta "Steel Framing e Isopanel" y tres claims.
 * En mobile las fotos ocupan una franja superior y el contenido va debajo.
 */
const claims = [
  {
    text: "Más de 100 casas llave en mano",
    icon: "M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25",
  },
  {
    text: "Más de 50 reformas y ampliaciones",
    icon: "M21.75 6.75a4.5 4.5 0 01-4.884 4.484c-1.076-.091-2.264.071-2.95.904l-7.152 8.684a2.548 2.548 0 11-3.586-3.586l8.684-7.152c.833-.686.995-1.874.904-2.95a4.5 4.5 0 016.336-4.486l-3.276 3.276a3.004 3.004 0 002.25 2.25l3.276-3.276c.256.565.398 1.192.398 1.852z",
  },
  {
    text: "Construimos con materiales de excelente calidad",
    icon: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z",
  },
];
---

<section class="hero relative overflow-hidden bg-white -mt-[4.5rem] lg:-mt-[5.5rem]" aria-labelledby="hero-title">
  <div class="hero-sky absolute inset-0" aria-hidden="true"></div>

  <!-- Fotos: estructura de steel framing (izq.) y casa (der.) -->
  <div class="hero-photos" aria-hidden="true">
    <img
      class="hero-photo hero-photo-left"
      src="/assets/images/hero/steelframing-new.jpg"
      alt="Estructura Steel Framing"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <img
      class="hero-photo hero-photo-right"
      src="/assets/images/hero/casa-new.jpg"
      alt="Casa terminada"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <!-- Contenido -->
  <div class="hero-content relative z-10 mx-auto max-w-4xl px-5 sm:px-8 pt-[5.5rem] pb-8 lg:pb-0 text-center lg:mt-0">
    <!-- Logo -->
    <a href="/" class="inline-block" aria-label="Pani Construcciones">
      <img
        src="/assets/icons/logo.webp"
        width="1144"
        height="640"
        alt="Pani Construcciones"
        class="h-auto w-[210px] sm:w-[320px] lg:w-[420px] mx-auto drop-shadow-md"
      />
    </a>

    <!-- Eslogan -->
    <div class="mt-5 lg:mt-7 flex items-center justify-center gap-3 sm:gap-4">
      <span class="hero-rule" aria-hidden="true"></span>
      <p class="font-bold uppercase tracking-[0.05em] text-[#0d1b2a] text-[0.62rem] sm:text-xs lg:text-sm whitespace-nowrap">
        Construyendo a Uruguay hace 15 años
      </p>
      <span class="hero-rule hero-rule-end" aria-hidden="true"></span>
    </div>

    <!-- Titular -->
    <h1
      id="hero-title"
      class="mt-4 lg:mt-5 font-archivo font-extrabold uppercase leading-[0.95] tracking-tight text-[#0d1b2a] text-[clamp(1.5rem,6.4vw,3.5rem)]"
    >
      Construimos tu hogar<br />
      <span class="text-[#005bb5]">llave en mano</span>
    </h1>

    <!-- Cinta -->
    <p class="mt-5 lg:mt-6 inline-block bg-[#008fd0] px-5 py-2.5 lg:px-7 lg:py-3 font-archivo font-bold uppercase tracking-[0.15em] text-white text-xs sm:text-sm lg:text-base shadow-lg">
      Steel Framing e Isopanel
    </p>

    <!-- Claims -->
    <ul class="mt-8 lg:mt-12 grid grid-cols-3 divide-x divide-custom-blue/20">
      {claims.map(({ text, icon }) => (
        <li class="flex flex-col items-center gap-2 px-2 sm:px-4 lg:px-6">
          <svg class="h-8 w-8 sm:h-10 sm:w-10 lg:h-12 lg:w-12 text-custom-blue" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
          </svg>
          <p class="font-archivo font-bold uppercase leading-snug text-custom-black text-[0.6rem] sm:text-xs lg:text-sm max-w-[11rem]">{text}</p>
        </li>
      ))}
    </ul>
  </div>

  <!-- Barra inferior azul — pegada al fondo del viewport -->
  <div class="hero-bar relative z-10 h-2 lg:h-2.5 bg-[#0b1f38]" aria-hidden="true"></div>
</section>

<style>
  @media (min-width: 1024px) {
    .hero {
      height: 100dvh;
      display: flex;
      flex-direction: column;
    }
  }

  .hero-sky {
    background: url('/assets/images/hero/sky.jpg') center top / cover no-repeat;
  }
  .hero-sky::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.75) 45%, #ffffff 100%);
  }

  /* Mobile: misma composición que desktop (referencia "hero mobile"): la estructura
     a la izquierda desde arriba, la casa a la derecha más abajo y el contenido
     centrado encima, con las fotos fundidas hacia el centro y hacia la base. */
  .hero-photos {
    position: absolute;
    inset: 0;
  }
  .hero-photo {
    position: absolute;
    object-fit: cover;
  }
  .hero-photo-left {
    left: 0;
    top: 0;
    width: 55%;
    height: 80%;
    object-position: 45% 40%;
    -webkit-mask-image:
      linear-gradient(to right, #000 25%, transparent 60%),
      linear-gradient(to bottom, #000 65%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, #000 25%, transparent 60%),
      linear-gradient(to bottom, #000 65%, transparent 100%);
    mask-composite: intersect;
  }
  .hero-photo-right {
    right: 0;
    top: 33%; /* arranca debajo del logo */
    width: 55%;
    height: 48%;
    object-position: 55% 50%;
    -webkit-mask-image:
      linear-gradient(to left, #000 25%, transparent 60%),
      linear-gradient(to bottom, transparent 0%, #000 22%, #000 85%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to left, #000 25%, transparent 60%),
      linear-gradient(to bottom, transparent 0%, #000 22%, #000 85%, transparent 100%);
    mask-composite: intersect;
  }
  .hero-photos::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #ffffff);
  }
  /* Halo blanco detrás del contenido para que el texto no compita con las fotos */
  .hero-content::before {
    content: "";
    position: absolute;
    inset: 2rem -2rem 0;
    z-index: -1;
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.9) 40%, rgba(255, 255, 255, 0) 72%);
  }

  .hero-rule {
    height: 1px;
    flex: 1 1 1.5rem;
    max-width: 7rem;
    background: linear-gradient(to right, transparent, #006494);
  }
  .hero-rule-end {
    background: linear-gradient(to left, transparent, #006494);
  }

  /* Desktop: fotos a los lados, a toda altura, fundidas hacia el contenido */
  @media (min-width: 1024px) {
    .hero-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding-top: 5.5rem;
    }
    .hero-photos {
      position: absolute;
      inset: 0;
      height: auto;
    }
    .hero-photos::after {
      display: none;
    }
    .hero-photo-left {
      top: 0;
      height: 100%;
      width: 34%;
      object-position: 50% 50%;
      -webkit-mask-image: linear-gradient(to right, #000 30%, transparent 88%);
      mask-image: linear-gradient(to right, #000 30%, transparent 88%);
    }
    .hero-photo-right {
      top: 0;
      height: 100%;
      width: 42%;
      object-position: 55% 50%;
      -webkit-mask-image: linear-gradient(to left, #000 35%, transparent 88%);
      mask-image: linear-gradient(to left, #000 35%, transparent 88%);
    }
    /* Halo blanco detrás del contenido para que el texto no compita con las fotos */
    .hero-content::before {
      content: "";
      position: absolute;
      inset: -1rem -4rem;
      z-index: -1;
      background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.92) 45%, rgba(255, 255, 255, 0) 75%);
    }
  }
</style>
