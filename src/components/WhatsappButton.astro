<div class="whatsapp-wrapper fixed right-5 bottom-6 lg:bottom-8 lg:right-10 z-30 wa-bounce-in">

  <!-- Globo de mensaje -->
  <div class="wa-tooltip" id="wa-tooltip">
    <p class="text-xs font-semibold text-gray-800 whitespace-nowrap">¡Hola! ¿En qué puedo ayudarte? 👋</p>
    <!-- Flecha del globo -->
    <span class="wa-tooltip-arrow"></span>
  </div>

  <!-- Anillos de pulso -->
  <span class="wa-ring wa-ring-1" aria-hidden="true"></span>
  <span class="wa-ring wa-ring-2" aria-hidden="true"></span>
  <span class="wa-ring wa-ring-3" aria-hidden="true"></span>

  <!-- Botón -->
  <a
    id="whatsapp-button"
    href="https://wa.me/598099491227"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Enviar mensaje a través de WhatsApp"
    class="relative flex items-center justify-center w-14 h-14 lg:w-16 lg:h-16 rounded-full bg-custom-green hover:bg-custom-whatsapp transition-colors duration-300 shadow-lg z-10"
  >
    <svg class="w-7 h-7 lg:w-8 lg:h-8" viewBox="0 0 448 512">
      <path fill="#fff" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
    </svg>
  </a>
</div>

<style>
  .whatsapp-wrapper {
    position: fixed;
  }

  /* Entrada con bounce */
  .wa-bounce-in {
    animation: wa-enter 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s both;
  }

  @keyframes wa-enter {
    from { transform: translateY(80px); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
  }

  /* Tooltip / globo */
  .wa-tooltip {
    position: absolute;
    bottom: calc(100% + 14px);
    right: 0;
    background: #fff;
    border-radius: 12px;
    padding: 8px 14px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    pointer-events: none;
    opacity: 0;
    transform: translateY(6px) scale(0.95);
    transform-origin: bottom right;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  /* Flecha */
  .wa-tooltip-arrow {
    position: absolute;
    bottom: -6px;
    right: 20px;
    width: 12px;
    height: 12px;
    background: #fff;
    transform: rotate(45deg);
    box-shadow: 2px 2px 4px rgba(0,0,0,0.06);
  }

  /* Hover en desktop */
  @media (hover: hover) {
    .whatsapp-wrapper:hover .wa-tooltip {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Auto-show en mobile */
  .wa-tooltip.wa-show {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Anillo base */
  .wa-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    opacity: 0;
    animation: wa-sonar 2.4s ease-out infinite;
  }

  .wa-ring-2 { animation-delay: 0.8s; }
  .wa-ring-3 { animation-delay: 1.6s; }

  @keyframes wa-sonar {
    0%   { transform: scale(1);   opacity: 0.5; }
    100% { transform: scale(2.2); opacity: 0;   }
  }
</style>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    // Solo en mobile (sin hover real)
    if (window.matchMedia("(hover: none)").matches) {
      const tooltip = document.getElementById("wa-tooltip");
      if (!tooltip) return;
      // Aparece 1.5s después de cargar, se oculta a los 4s
      setTimeout(() => {
        tooltip.classList.add("wa-show");
        setTimeout(() => tooltip.classList.remove("wa-show"), 4000);
      }, 1500);
    }
  });
</script>
