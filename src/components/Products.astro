---
import Cards from "../components/Cards.astro";
import Contact from "./Contact.astro";
import LineComparator from "./LineComparator.astro";
import {
  premium,
  executivePlus,
  basic,
} from "../utils/projects.js";
---

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-10">

  <div id="steelframing"></div>

  <!-- ── Toggle Sistema ── -->
  <div class="flex lg:hidden gap-2 mt-1 mb-4">
    <span class="flex-1 inline-flex items-center justify-center gap-2 font-archivo font-bold text-xs uppercase tracking-wide py-1 rounded-full bg-gradient-to-r from-custom-blue to-custom-original text-white opacity-60 cursor-default select-none border-2 border-transparent">
      Steel Framing
    </span>
    <a href="/isopanel" class="flex-1 inline-flex items-center justify-center gap-2 font-archivo font-bold text-xs uppercase tracking-wide py-1 rounded-full border-2 border-custom-blue text-custom-blue hover:bg-custom-blue hover:text-white transition-all duration-200">
      Ver Isopanel
    </a>
  </div>

  <!-- ── Línea Premium ── -->
  <div id="sf-premium" class="scroll-mt-24 mt-6 mb-3 reveal">
    <div class="flex items-center gap-3">
      <div class="flex-1 h-px bg-gradient-to-r from-custom-gold/40 to-transparent"></div>
      <span class="line-badge gold px-4 py-1.5 text-xs">★ Línea Premium</span>
      <div class="flex-1 h-px bg-gradient-to-l from-custom-gold/40 to-transparent"></div>
    </div>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-7">
    {premium.map((card, i) => <Cards {...card} eager={i < 3} />)}
  </div>

  <!-- ── Línea Ejecutiva Plus ── -->
  <div id="sf-exeplus" class="scroll-mt-24 mt-12 mb-3 reveal">
    <div class="flex items-center gap-3">
      <div class="flex-1 h-px bg-gradient-to-r from-custom-blue/30 to-transparent"></div>
      <span class="line-badge px-4 py-1.5 text-xs">Línea Ejecutiva Plus</span>
      <div class="flex-1 h-px bg-gradient-to-l from-custom-blue/30 to-transparent"></div>
    </div>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-7">
    {executivePlus.map((card) => <Cards {...card} />)}
  </div>

  <!-- ── Línea Básica ── -->
  <div id="sf-basic" class="scroll-mt-24 mt-12 mb-3 reveal">
    <div class="flex items-center gap-3">
      <div class="flex-1 h-px bg-gradient-to-r from-custom-blue/30 to-transparent"></div>
      <span class="line-badge px-4 py-1.5 text-xs">Línea Básica</span>
      <div class="flex-1 h-px bg-gradient-to-l from-custom-blue/30 to-transparent"></div>
    </div>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-7">
    {basic.map((card) => <Cards {...card} />)}
  </div>

  <!-- ── Comparador de Líneas ── -->
  <LineComparator system="Steel Framing" />

  <!-- ── Contact CTA (desactivado por ahora) ──
  <Contact />
  -->

</div>
