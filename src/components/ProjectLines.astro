---
/**
 * Sección con las tarjetas de Steel Framing e Isopanel y los accesos a sus líneas,
 * de a dos por fila en todos los tamaños de pantalla.
 * Prop opcional `systems` para mostrar una sola (p. ej. ["isopanel"] en /isopanel).
 */
import ProjectLinesCard from "./ProjectLinesCard.astro";

// Fotos reales de obras (public/assets/images/obras)
const IMAGES = {
  steelframing: "/assets/images/obras/1.webp",
  isopanel: "/assets/images/obras/15.webp",
};

const { systems = ["steelframing", "isopanel"] } = Astro.props;
const single = systems.length === 1;
---

<section id="proyectos" class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-10 lg:px-10 lg:py-14">
  <div class={`grid gap-3 sm:gap-6 ${single ? "mx-auto max-w-sm grid-cols-1" : "grid-cols-2"}`}>
    {systems.map((slug) => <ProjectLinesCard system={slug} image={IMAGES[slug]} id={slug} />)}
  </div>
</section>
