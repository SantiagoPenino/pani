---
import Header from "../components/Header.astro";
import { ViewTransitions } from "astro:transitions";
import Footer from "../components/Footer.astro";
import WhatsappButton from "../components/WhatsappButton.astro";
import ScrollTopButton from "../components/ScrollTopButton.astro";

export function getCanonicalUrl(pathname: string) {
  const baseUrl = "https://paniconstrucciones.com";
  return `${baseUrl}${pathname}`;
}

interface Props {
  title: string;
  description: string;
  imageUrl?: string;
}

const {
  title,
  description,
  // Imagen por defecto para compartir en redes cuando la página no define una
  imageUrl = "https://paniconstrucciones.com/assets/images/obras/1.webp",
} = Astro.props;
const canonicalUrl = getCanonicalUrl(Astro.url.pathname);

const pixelId = import.meta.env.PUBLIC_PIXEL_ID ?? "";
---

<!doctype html>
<html lang="es" class="overflow-x-hidden w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="max-image-preview:large" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta name="theme-color" content="#006494" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="stylesheet" href="/global.css" />

    <!-- Meta Pixel -->
    <script is:inline define:vars={{ pixelId }}>
      (() => {
        if (!pixelId) return;

        !function(f,b,e,v,n,t,s){
          if(f.fbq)return;
          n=f.fbq=function(){
            n.callMethod ? n.callMethod.apply(n,arguments) : n.queue.push(arguments)
          };
          if(!f._fbq)f._fbq=n;
          n.push=n;
          n.loaded=!0;
          n.version='2.0';
          n.queue=[];
          t=b.createElement(e);
          t.async=!0;
          t.src=v;
          s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)
        }(window, document,'script','https://connect.facebook.net/en_US/fbevents.js');

        fbq('init', pixelId);

        // Con ViewTransitions este script corre una sola vez por sesión (Astro no
        // re-ejecuta scripts idénticos al navegar), así que el PageView se registra
        // en cada astro:page-load, que también dispara en la carga inicial.
        if (!window.__paniPixelBound) {
          window.__paniPixelBound = true;
          document.addEventListener('astro:page-load', () => fbq('track', 'PageView'));
        }
      })();
    </script>

    {pixelId && (
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
        />
      </noscript>
    )}

    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="bg-white relative overflow-x-hidden w-full">
    <WhatsappButton />
    <ScrollTopButton />
    <Header />
    <main class="pt-[4.5rem] lg:pt-[5.5rem]">
      <slot />
    </main>
    <Footer />

    <!-- Favorites System -->
    <script is:inline>
      // Favorites manager
      window.getFavs = () => JSON.parse(localStorage.getItem('pani-favs') || '[]');
      window.saveFavs = (favs) => localStorage.setItem('pani-favs', JSON.stringify(favs));

      window.toggleFav = (btn) => {
        const code = btn.dataset.code;
        let favs = window.getFavs();
        const idx = favs.indexOf(code);
        if (idx > -1) {
          favs.splice(idx, 1);
        } else {
          favs.push(code);
        }
        window.saveFavs(favs);
        window.syncFavButtons();
        // Notify navbar badge to update
        window.dispatchEvent(new Event('favs-changed'));
      };

      window.syncFavButtons = () => {
        const favs = window.getFavs();
        document.querySelectorAll('.fav-btn').forEach(btn => {
          const code = btn.dataset.code;
          const isFav = favs.includes(code);
          btn.classList.toggle('is-fav', isFav);
          btn.querySelector('.fav-icon-empty').classList.toggle('hidden', isFav);
          btn.querySelector('.fav-icon-full').classList.toggle('hidden', !isFav);
        });
      };

      // DOMContentLoaded cubre la carga inicial y astro:after-swap las navegaciones
      // con ViewTransitions (no dispara en la carga inicial, así no corre dos veces).
      document.addEventListener('DOMContentLoaded', () => window.syncFavButtons());
      document.addEventListener('astro:after-swap', () => window.syncFavButtons());
    </script>

    <!-- Animaciones .reveal: un único observer global para todas las páginas -->
    <script is:inline>
      (() => {
        function revealOnScroll() {
          const reveals = document.querySelectorAll(".reveal:not(.visible)");
          if (!reveals.length) return;
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("visible");
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08 }
          );
          reveals.forEach((el) => io.observe(el));
        }

        // Este script está al final del <body>: en la carga inicial el DOM ya está parseado.
        revealOnScroll();
        document.addEventListener("astro:after-swap", revealOnScroll);
      })();
    </script>

    <!-- Desactivar y limpiar Service Worker si quedó cacheado -->
    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.getRegistrations().then((regs) => {
          for (const reg of regs) {
            reg.unregister();
          }
        });
      }
      if ("caches" in window) {
        caches.keys().then((keys) => {
          keys.forEach((k) => caches.delete(k));
        });
      }
    </script>
  </body>
</html>
